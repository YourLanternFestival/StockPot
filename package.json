{
  "name": "in-out",
  "version": "2.2.2",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:update": "node scripts/build-update.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "^4.0.4",
    "archiver": "^8.0.0",
    "electron": "^42.3.1",
    "electron-builder": "^26.15.2",
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "com.yang-an.inventory",
    "productName": "食堂物资管理",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/img/icon-256.png",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "食堂物资管理"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "date-util.js",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
